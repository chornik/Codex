DATABASE_URL="file:./dev.db"
UPLOAD_DIR="./data/uploads"
# Optional: enables live web research instead of the fictional demo catalog.
# BRAVE_SEARCH_API_KEY=""
# Set to "brave" only after providing the optional key above.
# Default (no external APIs):
SEARCH_PROVIDER="demo"

# No tool telemetry or CLI update checks needed for this local MVP.
CHECKPOINT_DISABLE="1"
NEXT_TELEMETRY_DISABLED="1"

# Browserdemo: wird durch npm run browser im Codespace automatisch gesetzt.
# APP_ORIGIN="https://EXAKTE-PRIVATE-CODESPACE-ADRESSE.app.github.dev"

# Optionale gehostete Demo: Passwort NUR in sicheren Hosting-Einstellungen setzen.
# DEMO_AUTH_REQUIRED="1"
# DEMO_USERNAME="demo"
# DEMO_PASSWORD=""
# APP_ORIGIN="https://deine-exakte-website.example"
