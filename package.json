{
  "name": "hotel-parts-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "samples": "tsx scripts/create-samples.ts",
    "browser": "node scripts/browser-start.mjs",
    "web": "node scripts/web-start.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "test:preview": "npm run preview:build && playwright test --config playwright.preview.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-libsql": "6.19.3",
    "@prisma/client": "6.19.3",
    "@tesseract.js-data/eng": "1.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "lucide-react": "^0.468.0",
    "next": "16.4.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.62.0",
    "sharp": "0.35.5",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.4.1",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
